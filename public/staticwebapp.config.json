{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/_expo/*",
      "/assets/*",
      "/api/*",
      "/*.{css,js,png,jpg,jpeg,gif,svg,ico,map,txt,json,woff,woff2,ttf,otf,webp}"
    ]
  },
  "mimeTypes": {
    ".json": "application/json"
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}
